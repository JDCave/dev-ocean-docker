# Hermes Agent Environment Configuration
# Copy this file to .env and fill in your API keys
# 完整配置参考: https://github.com/NousResearch/hermes-agent/blob/main/.env.example

# =============================================================================
# LLM PROVIDER — 选择一个或多个 LLM 提供商
# =============================================================================
# OpenRouter — 推荐，统一接入多种模型
# 获取地址: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Google AI Studio / Gemini — 直连 Google
# 获取地址: https://aistudio.google.com/app/apikey
# GOOGLE_API_KEY=
# GEMINI_API_KEY=

# z.ai / ZhipuAI GLM — 智谱 GLM 模型
# 获取地址: https://z.ai 或 https://open.bigmodel.cn
# GLM_API_KEY=

# Kimi / Moonshot — Kimi Code 编程模型
# 获取地址: https://platform.kimi.ai
# KIMI_API_KEY=

# MiniMax — MiniMax 模型
# 获取地址: https://www.minimax.io
# MINIMAX_API_KEY=

# Hugging Face Inference — 开源模型推理
# 获取地址: https://huggingface.co/settings/tokens
# HF_TOKEN=

# =============================================================================
# TOOL API KEYS — 工具 API Keys
# =============================================================================
# Exa — AI 原生网页搜索
# 获取地址: https://exa.ai
# EXA_API_KEY=

# Firecrawl — 网页搜索、提取、爬取
# 获取地址: https://firecrawl.dev/
# FIRECRAWL_API_KEY=

# FAL.ai — 图片生成
# 获取地址: https://fal.ai/
# FAL_KEY=

# =============================================================================
# BROWSER TOOL — 浏览器自动化（可选）
# =============================================================================
# Browserbase — 云端浏览器执行
# 获取地址: https://browserbase.com/
# BROWSERBASE_API_KEY=
# BROWSERBASE_PROJECT_ID=
# BROWSERBASE_PROXIES=true
# BROWSERBASE_ADVANCED_STEALTH=false

# =============================================================================
# VOICE — 语音转写与 TTS（可选）
# =============================================================================
# OpenAI Whisper + TTS（直连 OpenAI API，不走 OpenRouter）
# 获取地址: https://platform.openai.com/api-keys
# VOICE_TOOLS_OPENAI_KEY=

# Groq — 免费 Whisper STT
# 获取地址: https://console.groq.com
# GROQ_API_KEY=

# =============================================================================
# MESSAGING PLATFORMS — 消息平台集成（可选）
# =============================================================================
# Telegram
# 获取 Bot Token: https://t.me/BotFather
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALLOWED_USERS=
# TELEGRAM_HOME_CHANNEL=
# TELEGRAM_HOME_CHANNEL_NAME=

# Slack
# 获取地址: https://api.slack.com/apps
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_APP_TOKEN=xapp-...
# SLACK_ALLOWED_USERS=

# WhatsApp（内置 Baileys 桥接，运行 `hermes whatsapp` 配对）
# WHATSAPP_ENABLED=false
# WHATSAPP_ALLOWED_USERS=

# Email（IMAP/SMTP）
# Gmail: 启用两步验证 → 创建应用专用密码 https://myaccount.google.com/apppasswords
# EMAIL_ADDRESS=
# EMAIL_PASSWORD=
# EMAIL_IMAP_HOST=imap.gmail.com
# EMAIL_IMAP_PORT=993
# EMAIL_SMTP_HOST=smtp.gmail.com
# EMAIL_SMTP_PORT=587
# EMAIL_POLL_INTERVAL=15
# EMAIL_ALLOWED_USERS=
# EMAIL_HOME_ADDRESS=

# =============================================================================
# TERMINAL TOOL — 终端工具配置
# =============================================================================
# 后端类型: local（默认）, docker, singularity, modal, ssh
# 通常通过 config.yaml 配置: hermes config set terminal.backend local
# TERMINAL_ENV=local
TERMINAL_TIMEOUT=60
TERMINAL_LIFETIME_SECONDS=300

# =============================================================================
# GATEWAY — 网关设置
# =============================================================================
# 是否允许所有用户访问（默认 false = 需要白名单）
# GATEWAY_ALLOW_ALL_USERS=false

# =============================================================================
# DEBUG — 调试选项
# =============================================================================
WEB_TOOLS_DEBUG=false
VISION_TOOLS_DEBUG=false
MOA_TOOLS_DEBUG=false
IMAGE_TOOLS_DEBUG=false

# =============================================================================
# GITHUB — Skills Hub（技能搜索/安装/发布）
# =============================================================================
# GitHub Personal Access Token — 提高 API 速率限制
# 获取地址: https://github.com/settings/tokens
# GITHUB_TOKEN=

# =============================================================================
# 使用说明
# =============================================================================
# 1. 复制此文件为 .env: cp .env.example .env
# 2. 至少填入一个 LLM 提供商的 API Key（推荐 OpenRouter）
# 3. 模型配置在 config.yaml 中: hermes model 或 hermes setup
# 4. 启动容器: ./quick-start.sh
# 5. 首次启动会自动生成 config.yaml（从官方模板复制）
#
# 注意：
# - API Key 明文存储，确保 .env 不被提交到版本控制
# - config.yaml 中的配置优先级高于 .env
# - 运行 `hermes setup` 可交互式配置所有选项
