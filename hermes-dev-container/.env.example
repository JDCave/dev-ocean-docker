# Hermes Development Environment - 环境变量配置
# 复制为 .env 并根据需要修改

# ============================================
# Hermes 源代码路径
# ============================================
# Hermes Agent 源代码在主机上的路径（用于 Docker 构建上下文）
# 默认: D:/Code/opensource/NousResearch/hermes-agent
# HERMES_SOURCE_PATH=D:/Code/opensource/NousResearch/hermes-agent

# ============================================
# Hermes 数据目录映射
# ============================================
# 主机上的 Hermes 数据目录（配置、日志、会话等）
# 首次启动时，容器会自动创建 config.yaml 和 .env（从官方模板复制）
HERMES_DATA_PATH=D:/Hermes


# ============================================
# 端口配置
# ============================================
# Hermes Gateway 端口（默认 8301）
HERMES_GATEWAY_PORT=8301

# Hermes Dashboard 端口（默认 9119）
HERMES_DASHBOARD_PORT=9119


# ============================================
# 用户权限映射（可选）
# ============================================
# 容器内 hermes 用户的 UID/GID，用于匹配主机用户
# 确保容器创建的文件在主机上可读写
# Linux/macOS: 设为 $(id -u) / $(id -g)
# Windows: 通常保持默认即可
HERMES_UID=10000
HERMES_GID=10000


# ============================================
# 代码和 SSH 目录映射
# ============================================
# 代码目录（主机 -> 容器 /workspace/code）
CODE_PATH=D:/Code

# SSH 密钥目录（主机 -> 容器 /root/.ssh）
# Windows 默认: C:/Users/<用户名>/.ssh
# Linux/macOS 默认: $HOME/.ssh
# SSH_PATH=~/.ssh


# ============================================
# 使用说明
# ============================================
# 1. 复制此文件为 .env: cp .env.example .env
# 2. 根据需要修改上面的配置
# 3. 启动容器: ./quick-start.sh
# 4. 首次启动后，编辑 Hermes 配置:
#    - Windows: %HERMES_DATA_PATH%/config.yaml
#    - 填入 LLM API Key 等配置
# 5. 重启容器使配置生效: docker-compose restart
#
# 注意：
# - HERMES_DATA_PATH 目录会被创建（如果不存在）
# - 首次启动会自动从模板生成 config.yaml 和 .env
# - 如需重新生成配置，删除 HERMES_DATA_PATH 下的对应文件后重启
