# OpenClaw Development Environment - 环境变量配置
# 复制为 .env 并填入你的真实值

# ============================================
# OpenClaw Gateway 配置
# ============================================
# Gateway 端口（默认 18789）
OPENCLAW_GATEWAY_PORT=18789

# Gateway 绑定地址（lan / localhost / all）
OPENCLAW_GATEWAY_BIND=lan

# 默认模型（可选）
OPENCLAW_MODEL=openrouter/stepfun/step-3.5-flash:free

# 工作空间路径（可选）
OPENCLAW_WORKSPACE=/root/.openclaw/workspace


# ============================================
# 必需 API Keys
# ============================================

# OpenRouter API Key
# 获取地址: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Tavily Search API Key
# 获取地址: https://tavily.com/ (注册后 API Keys 页面)
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# ============================================
# 飞书 (Feishu) 配置
# ============================================
# 创建方式：飞书开放平台 → 创建企业内部应用 → 获取 App ID 和 App Secret
# 参考：https://open.feishu.cn/document/ukTMukTMukTM/uIjNz4iM2MjLyYzM

FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 飞书群组 ID（允许接收消息的群组）
# 多个群组用逗号分隔，如 "oc_aaa,oc_bbb,oc_ccc"
# 获取方式：飞书群组设置 → 群组ID（在 URL 中）
FEISHU_GROUP_IDS=oc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# ============================================
# Notion 配置（可选）
# ============================================
# Notion Integration API Key
# 获取地址：https://www.notion.so/my-integrations
# 需要先创建 Integration 并分享数据库给该 Integration
NOTION_API_KEY=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Notion Database ID（用于存储 AI 笔记）
# 创建数据库后，从 URL 中提取：https://www.notion.so/username/xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# ============================================
# 使用说明
# ============================================
# 1. 复制此文件为 .env: cp .env.example .env
# 2. 编辑 .env，填入真实的 API Keys 和配置
# 3. 启动容器: docker-compose up -d
# 4. 查看日志: docker-compose logs -f openclaw
# 5. 停止容器: docker-compose down
#
# 注意：
# - 所有 Key 都是明文存储，请确保 .env 文件不被提交到版本控制
# - Feishu 应用需要启用 "接收消息" 权限
# - Notion Integration 需要分享数据库才能写入
# - 如果不需要某服务（如 Notion），可以留空但不要删除环境变量
